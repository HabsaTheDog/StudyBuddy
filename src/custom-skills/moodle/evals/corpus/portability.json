{
  "schemaVersion": 1,
  "id": "study-buddy-portability-template",
  "version": "1.0.0",
  "description": "Opt-in portability benchmark templates for unseen non-technical Moodle courses. Replace each example URL with a real enrolled course URL, enable the case, and set course-specific required terms before execution.",
  "cases": [
    {
      "id": "unseen-literature-en",
      "revision": 1,
      "enabled": false,
      "prompt": "Create an English PDF study guide for this literature course. Preserve its actual unit and reading sequence, explain the central interpretations and debates, and include representative close-reading or essay-planning applications grounded only in the Moodle materials.",
      "language": "en",
      "moodleUrl": "https://learn.example.edu/course/view.php?id=replace-literature",
      "tags": ["portability", "unseen-course", "humanities", "english", "conceptual", "case-based"],
      "expected": {
        "requirePdf": true,
        "requireCompleteCoverage": true,
        "requireQualityReview": true,
        "requiredLanguage": "en",
        "requiredContentModes": ["conceptual", "case_based"],
        "minTopics": 6,
        "maxFormulas": 2,
        "minWorkedExamples": 2,
        "minSources": 4,
        "minCourseChapters": 3,
        "minCoveredChapters": 3,
        "minChaptersWithWorkedExamples": 2,
        "requiredTerms": [],
        "forbiddenTerms": ["FH Technikum Wien", "Engineering Study Documents"],
        "maxWallMs": 480000,
        "maxFreshInputTokens": 250000,
        "maxModelCalls": 10,
        "maxRetries": 2,
        "maxLeafToolPolicyViolations": 0,
        "maxInputAmplification": 6,
        "maxSelectedResources": 12,
        "maxResourceAttempts": 20
      }
    },
    {
      "id": "unseen-language-course-en",
