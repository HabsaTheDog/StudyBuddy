{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "course",
    "language",
    "layout",
    "sections",
    "quiz_questions",
    "source_map",
    "requirements_trace",
    "risk_flags"
  ],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "course": { "type": ["string", "null"] },
    "language": { "type": "string" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_style", "density", "include_toc", "quiz_solutions_position"],
      "properties": {
        "document_style": { "type": "string" },
        "density": { "type": "string" },
        "include_toc": { "type": "boolean" },
        "quiz_solutions_position": { "type": "string", "enum": ["end"] }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "body", "source_ids"],
        "properties": {
          "heading": { "type": "string" },
          "body": { "type": "array", "items": { "type": "string" } },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "quiz_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question_type", "question", "options", "answer", "explanation", "source_ids"],
        "properties": {
          "id": { "type": "string" },
          "question_type": { "type": "string" },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "answer": { "type": "string" },
          "explanation": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "source_map": { "type": "array", "items": { "type": "object" } },
    "requirements_trace": { "type": "array", "items": { "type": "object" } },
    "risk_flags": { "type": "array", "items": { "type": "string" } }
  }
}
