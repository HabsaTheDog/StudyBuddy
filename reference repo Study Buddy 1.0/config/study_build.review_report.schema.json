{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "issues", "repair_instructions", "requirements_trace", "safety"],
  "properties": {
    "passed": { "type": "boolean" },
    "issues": { "type": "array", "items": { "type": "object" } },
    "repair_instructions": { "type": "array", "items": { "type": "string" } },
    "requirements_trace": { "type": "array", "items": { "type": "object" } },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["quiz_permission_status", "quiz_opened", "final_submission_allowed"],
      "properties": {
        "quiz_permission_status": { "type": "string" },
        "quiz_opened": { "type": "boolean" },
        "final_submission_allowed": { "type": "boolean" }
      }
    }
  }
}
