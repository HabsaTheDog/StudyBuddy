{
  "name": "uni-agent-study-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "Local provider-neutral workspace for a FH Technikum Wien Moodle assistant.",
  "scripts": {
    "browser:install": "agent-browser install",
    "browser:install:linux-deps": "agent-browser install --with-deps",
    "py": "node scripts/run_python.js",
    "moodle:login": "node scripts/run_python.js -m uni_agent.orchestrator login",
    "moodle:snapshot": "node scripts/run_python.js -m uni_agent.orchestrator snapshot",
    "moodle:courses": "node scripts/run_python.js -m uni_agent.orchestrator courses",
    "moodle:materials": "node scripts/run_python.js -m uni_agent.orchestrator materials",
    "moodle:sync": "node scripts/run_python.js -m uni_agent.orchestrator sync",
    "providers": "node scripts/run_python.js -m uni_agent.orchestrator providers",
    "activity:resolve": "node scripts/run_python.js -m uni_agent.orchestrator activity-resolve",
    "study:buddy": "node scripts/run_python.js -m uni_agent.assistant",
    "study:build": "node scripts/run_python.js -m uni_agent.orchestrator study-build",
    "quiz:assist": "node scripts/run_python.js -m uni_agent.orchestrator quiz",
    "test": "node scripts/run_python.js -m compileall src scripts && node scripts/run_python.js -m unittest discover -s tests"
  },
  "dependencies": {
    "agent-browser": "^0.26.0"
  }
}
