MOODLE_BASE_URL=https://moodle.technikum-wien.at
MOODLE_DASHBOARD_URL=https://moodle.technikum-wien.at/my/
MOODLE_USERNAME=
MOODLE_PASSWORD=

BROWSER_HEADLESS=false
BROWSER_STATE_DIR=state/browser
OUTPUT_DIR=output
DATA_DIR=data
STATE_DIR=state

# Agent provider settings. `auto` prefers Codex when installed, then a configured custom command.
STUDY_BUDDY_AGENT_PROVIDER=auto
STUDY_BUDDY_AGENT_COMMAND=
STUDY_BUDDY_AGENT_TIMEOUT_SECONDS=300

# Optional quiz subagent backend. Command hooks take precedence over provider selection.
# Set command to `off` to create packet/screenshot artifacts without asking a subagent.
SUBAGENT_SOLVER_PROVIDER=
SUBAGENT_SOLVER_COMMAND=
SUBAGENT_TIMEOUT_SECONDS=300

# Optional adaptive document-build section hook. Commands take precedence over provider selection.
# Commands may use {packet}, {output}, {schema}, {screenshot}, {root}, and {prompt_file} placeholders.
DOCUMENT_BUILD_SECTION_PROVIDER=
DOCUMENT_BUILD_SECTION_COMMAND=

# Legacy study-build model hooks kept for compatibility with older scripts.
STUDY_BUILD_BUILDER_PROVIDER=
STUDY_BUILD_BUILDER_COMMAND=
STUDY_BUILD_REVIEWER_PROVIDER=
STUDY_BUILD_REVIEWER_COMMAND=
