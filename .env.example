# ──────────────────────────────────────────────────────────────
# Study Buddy 2.0 — Environment Variables
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Or run the interactive setup:
#   npm run setup
#
# Optionally create .env.local for machine-specific overrides.
# Loading order: .env.local → .env (first value wins)
# ──────────────────────────────────────────────────────────────

# ── Moodle credentials ──
MOODLE_BASE_URL=https://moodle.technikum-wien.at
MOODLE_DASHBOARD_URL=https://moodle.technikum-wien.at/my/
MOODLE_USERNAME=
MOODLE_PASSWORD=
MOODLE_STORAGE_STATE=
MOODLE_HEADLESS=true

# ── CIS credentials ──
CIS_BASE_URL=https://cis.technikum-wien.at
CIS_DASHBOARD_URL=https://cis.technikum-wien.at/cis.php/
CIS_URLS=https://cis.technikum-wien.at/cis.php/
CIS_CALENDAR_URL=
CIS_USERNAME=
CIS_PASSWORD=
CIS_STORAGE_STATE=
CIS_MAX_PAGES=8

# ── Runtime limits ──
MOODLE_MAX_RUNTIME_MS=
MOODLE_IDLE_TIMEOUT_MS=
MOODLE_ARTIFACT_MAX_RUNTIME_MS=2700000
MOODLE_ARTIFACT_IDLE_TIMEOUT_MS=900000
MOODLE_EXTRACT_MAX_RUNTIME_MS=2700000
MOODLE_EXTRACT_IDLE_TIMEOUT_MS=900000
MOODLE_RENDER_MAX_RUNTIME_MS=1200000
MOODLE_RENDER_IDLE_TIMEOUT_MS=900000

# ── Study Buddy behaviour ──
STUDY_BUDDY_SOURCE_MODE=auto
STUDY_BUDDY_DOWNLOAD_CONCURRENCY=3
STUDY_BUDDY_TYPST_VALIDATION=balanced
STUDY_BUDDY_RENDER_STRATEGY=auto
STUDY_BUDDY_VISUALS_DISABLE=false
STUDY_BUDDY_VISUALS_MAX=0
STUDY_BUDDY_VISUALS_MIN_CONFIDENCE=0.65
